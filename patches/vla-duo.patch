+// PI0 ViT xmem GEMM (PI0_VIT_XMEM=1): activation / result images, one per distinct (w, h), reused across calls.
+// The in-order queue makes the reuse safe.
+struct ggml_cl_pi0_img_cache {
+    struct entry { size_t w = 0, h = 0; cl_mem img = nullptr; };
+    entry e[8];
+
+    ~ggml_cl_pi0_img_cache() {
+        for (auto & x : e) {
+            if (x.img) { clReleaseMemObject(x.img); }
+        }
+    }
+
+    // RGBA half image2d of exactly w x h. Entry 0 is recycled when the table is full.
+    cl_mem get(cl_context context, size_t w, size_t h) {
+        for (auto & x : e) {
+            if (x.img && x.w == w && x.h == h) { return x.img; }
+        }
+        entry * slot = &e[0];
+        for (auto & x : e) {
+            if (!x.img) { slot = &x; break; }
+        }
+        if (slot->img) { CL_CHECK(clReleaseMemObject(slot->img)); }
+        cl_image_format fmt = { CL_RGBA, CL_HALF_FLOAT };
+        cl_image_desc desc = {};
+        desc.image_type   = CL_MEM_OBJECT_IMAGE2D;
+        desc.image_width  = w;
+        desc.image_height = h;
+        cl_int err;
+        CL_CHECK((slot->img = clCreateImage(context, CL_MEM_READ_WRITE, &fmt, &desc, NULL, &err), err));
+        slot->w = w; slot->h = h;
+        return slot->img;
+    }
+};
