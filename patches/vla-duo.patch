+    int idx = (gy<<3)*m + (gx<<2);
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s0,c1.s0,c2.s0,c3.s0),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s1,c1.s1,c2.s1,c3.s1),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s2,c1.s2,c2.s2,c3.s2),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s3,c1.s3,c2.s3,c3.s3),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s4,c1.s4,c2.s4,c3.s4),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s5,c1.s5,c2.s5,c3.s5),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s6,c1.s6,c2.s6,c3.s6),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s7,c1.s7,c2.s7,c3.s7),0,dst+idx); }
+}
+
+// 2D-launch variant of the f16-weight kernel (one N-tile per work-group). Used for the ViT GEMMs.
+kernel void kernel_mul_mat_Ab_Bi_8x4_f16_2d(
+        global const half * src0_w,         // f16 A (weights), [K][M] M-contiguous
+        __read_only image1d_buffer_t src1,  // B (1d image, f16 Bi)
+        global float * dst,                 // C
+        int m, int n, int k, int n_no_padding
+) {
+    int n_4 = n >> 2;
+    int gy = get_global_id(0);   // N-tile
+    int gx = get_global_id(1);   // M-tile
+    int gx_2 = gx << 2;
+    if (gx_2 >= m) { return; }   // M/4 need not be a multiple of the local size
+
+    half8 c0 = 0, c1 = 0, c2 = 0, c3 = 0;
+    half8 B;
+    half4 w;
+    __global const half* weight_ptr = src0_w + gx_2;
+
+    int i = 0;
+    for(; i+3 < k; i+=4){
+        B.s0123 = read_imageh(src1, gy*2 + (i)*(n_4));   B.s4567 = read_imageh(src1, gy*2 + (i)*(n_4)+1);
+        w = vload4(0, weight_ptr + (i)*(m));   c0 += B*w.s0; c1 += B*w.s1; c2 += B*w.s2; c3 += B*w.s3;
+        B.s0123 = read_imageh(src1, gy*2 + (i+1)*(n_4)); B.s4567 = read_imageh(src1, gy*2 + (i+1)*(n_4)+1);
+        w = vload4(0, weight_ptr + (i+1)*(m)); c0 += B*w.s0; c1 += B*w.s1; c2 += B*w.s2; c3 += B*w.s3;
+        B.s0123 = read_imageh(src1, gy*2 + (i+2)*(n_4)); B.s4567 = read_imageh(src1, gy*2 + (i+2)*(n_4)+1);
+        w = vload4(0, weight_ptr + (i+2)*(m)); c0 += B*w.s0; c1 += B*w.s1; c2 += B*w.s2; c3 += B*w.s3;
+        B.s0123 = read_imageh(src1, gy*2 + (i+3)*(n_4)); B.s4567 = read_imageh(src1, gy*2 + (i+3)*(n_4)+1);
+        w = vload4(0, weight_ptr + (i+3)*(m)); c0 += B*w.s0; c1 += B*w.s1; c2 += B*w.s2; c3 += B*w.s3;
+    }
+    for(; i < k; i++){
+        B.s0123 = read_imageh(src1, gy*2 + (i)*(n_4)); B.s4567 = read_imageh(src1, gy*2 + (i)*(n_4)+1);
+        w = vload4(0, weight_ptr + (i)*(m)); c0 += B*w.s0; c1 += B*w.s1; c2 += B*w.s2; c3 += B*w.s3;
+    }
+
+    int idx = (gy<<3)*m + gx_2;
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s0,c1.s0,c2.s0,c3.s0),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s1,c1.s1,c2.s1,c3.s1),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s2,c1.s2,c2.s2,c3.s2),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s3,c1.s3,c2.s3,c3.s3),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s4,c1.s4,c2.s4,c3.s4),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s5,c1.s5,c2.s5,c3.s5),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s6,c1.s6,c2.s6,c3.s6),0,dst+idx); idx+=m; }
+    if(idx+3 < m*n_no_padding){ vstore4((float4)(c0.s7,c1.s7,c2.s7,c3.s7),0,dst+idx); }
+}
+
+// 16N x 8M variant of the f16-weight kernel (not launched).
+kernel void kernel_mul_mat_Ab_Bi_16x8_f16(
+        global const half * src0_w,
+        __read_only image1d_buffer_t src1,
+        global float * dst,
+        int m, int n, int k, int n_no_padding
+) {
+    int n_4 = n >> 2;
+    int m_tiles = (m + 7) >> 3;
+    int n_tiles = (n_no_padding + 15) >> 4;
+    int flat = get_global_id(0);
+    int gy = flat / m_tiles;
+    if (gy >= n_tiles) { return; }
+    int gx = flat - gy * m_tiles;
+    int gx_8 = gx << 3;
+
+    half8 cL0=0,cL1=0,cL2=0,cL3=0,cL4=0,cL5=0,cL6=0,cL7=0;
+    half8 cH0=0,cH1=0,cH2=0,cH3=0,cH4=0,cH5=0,cH6=0,cH7=0;
+    half8 BL, BH, w;
+    __global const half* weight_ptr = src0_w + gx_8;
+
+    int i = 0;
+    for(; i+3 < k; i+=4){
+#define STEP16(J) { int base = gy*4 + (i+J)*n_4;                                     \
+        BL.s0123 = read_imageh(src1, base+0); BL.s4567 = read_imageh(src1, base+1);  \
+        BH.s0123 = read_imageh(src1, base+2); BH.s4567 = read_imageh(src1, base+3);  \
+        w = vload8(0, weight_ptr + (i+J)*m);                                         \
+        cL0+=BL*w.s0; cH0+=BH*w.s0; cL1+=BL*w.s1; cH1+=BH*w.s1;                       \
+        cL2+=BL*w.s2; cH2+=BH*w.s2; cL3+=BL*w.s3; cH3+=BH*w.s3;                       \
+        cL4+=BL*w.s4; cH4+=BH*w.s4; cL5+=BL*w.s5; cH5+=BH*w.s5;                       \
+        cL6+=BL*w.s6; cH6+=BH*w.s6; cL7+=BL*w.s7; cH7+=BH*w.s7; }
+        STEP16(0); STEP16(1); STEP16(2); STEP16(3);
+    }
+    for(; i < k; i++){ STEP16(0); }
+#undef STEP16
+
+    int n_row0 = gy << 4;
+    int m_col0 = gx << 3;
+    if (m_col0 + 7 < m && n_row0 + 15 < n_no_padding) {
+        int idx = n_row0*m + m_col0;
+        vstore8((float8)(cL0.s0,cL1.s0,cL2.s0,cL3.s0,cL4.s0,cL5.s0,cL6.s0,cL7.s0),0,dst+idx); idx+=m;
+        vstore8((float8)(cL0.s1,cL1.s1,cL2.s1,cL3.s1,cL4.s1,cL5.s1,cL6.s1,cL7.s1),0,dst+idx); idx+=m;
+        vstore8((float8)(cL0.s2,cL1.s2,cL2.s2,cL3.s2,cL4.s2,cL5.s2,cL6.s2,cL7.s2),0,dst+idx); idx+=m;
+        vstore8((float8)(cL0.s3,cL1.s3,cL2.s3,cL3.s3,cL4.s3,cL5.s3,cL6.s3,cL7.s3),0,dst+idx); idx+=m;
+        vstore8((float8)(cL0.s4,cL1.s4,cL2.s4,cL3.s4,cL4.s4,cL5.s4,cL6.s4,cL7.s4),0,dst+idx); idx+=m;
+        vstore8((float8)(cL0.s5,cL1.s5,cL2.s5,cL3.s5,cL4.s5,cL5.s5,cL6.s5,cL7.s5),0,dst+idx); idx+=m;
+        vstore8((float8)(cL0.s6,cL1.s6,cL2.s6,cL3.s6,cL4.s6,cL5.s6,cL6.s6,cL7.s6),0,dst+idx); idx+=m;
+        vstore8((float8)(cL0.s7,cL1.s7,cL2.s7,cL3.s7,cL4.s7,cL5.s7,cL6.s7,cL7.s7),0,dst+idx); idx+=m;
+        vstore8((float8)(cH0.s0,cH1.s0,cH2.s0,cH3.s0,cH4.s0,cH5.s0,cH6.s0,cH7.s0),0,dst+idx); idx+=m;
+        vstore8((float8)(cH0.s1,cH1.s1,cH2.s1,cH3.s1,cH4.s1,cH5.s1,cH6.s1,cH7.s1),0,dst+idx); idx+=m;
+        vstore8((float8)(cH0.s2,cH1.s2,cH2.s2,cH3.s2,cH4.s2,cH5.s2,cH6.s2,cH7.s2),0,dst+idx); idx+=m;
+        vstore8((float8)(cH0.s3,cH1.s3,cH2.s3,cH3.s3,cH4.s3,cH5.s3,cH6.s3,cH7.s3),0,dst+idx); idx+=m;
+        vstore8((float8)(cH0.s4,cH1.s4,cH2.s4,cH3.s4,cH4.s4,cH5.s4,cH6.s4,cH7.s4),0,dst+idx); idx+=m;
+        vstore8((float8)(cH0.s5,cH1.s5,cH2.s5,cH3.s5,cH4.s5,cH5.s5,cH6.s5,cH7.s5),0,dst+idx); idx+=m;
+        vstore8((float8)(cH0.s6,cH1.s6,cH2.s6,cH3.s6,cH4.s6,cH5.s6,cH6.s6,cH7.s6),0,dst+idx); idx+=m;
+        vstore8((float8)(cH0.s7,cH1.s7,cH2.s7,cH3.s7,cH4.s7,cH5.s7,cH6.s7,cH7.s7),0,dst+idx);
+    } else {
+#define STROW(NR, C0,C1,C2,C3,C4,C5,C6,C7, S)                                        \
+        if (n_row0+(NR) < n_no_padding) { int b=(n_row0+(NR))*m+m_col0;              \
+            if(m_col0+0<m)dst[b+0]=C0.S; if(m_col0+1<m)dst[b+1]=C1.S;                 \
+            if(m_col0+2<m)dst[b+2]=C2.S; if(m_col0+3<m)dst[b+3]=C3.S;                 \
+            if(m_col0+4<m)dst[b+4]=C4.S; if(m_col0+5<m)dst[b+5]=C5.S;                 \
+            if(m_col0+6<m)dst[b+6]=C6.S; if(m_col0+7<m)dst[b+7]=C7.S; }
+        STROW(0,  cL0,cL1,cL2,cL3,cL4,cL5,cL6,cL7, s0);
+        STROW(1,  cL0,cL1,cL2,cL3,cL4,cL5,cL6,cL7, s1);
+        STROW(2,  cL0,cL1,cL2,cL3,cL4,cL5,cL6,cL7, s2);
+        STROW(3,  cL0,cL1,cL2,cL3,cL4,cL5,cL6,cL7, s3);
+        STROW(4,  cL0,cL1,cL2,cL3,cL4,cL5,cL6,cL7, s4);
+        STROW(5,  cL0,cL1,cL2,cL3,cL4,cL5,cL6,cL7, s5);
+        STROW(6,  cL0,cL1,cL2,cL3,cL4,cL5,cL6,cL7, s6);
+        STROW(7,  cL0,cL1,cL2,cL3,cL4,cL5,cL6,cL7, s7);
+        STROW(8,  cH0,cH1,cH2,cH3,cH4,cH5,cH6,cH7, s0);
+        STROW(9,  cH0,cH1,cH2,cH3,cH4,cH5,cH6,cH7, s1);
+        STROW(10, cH0,cH1,cH2,cH3,cH4,cH5,cH6,cH7, s2);
+        STROW(11, cH0,cH1,cH2,cH3,cH4,cH5,cH6,cH7, s3);
+        STROW(12, cH0,cH1,cH2,cH3,cH4,cH5,cH6,cH7, s4);
+        STROW(13, cH0,cH1,cH2,cH3,cH4,cH5,cH6,cH7, s5);
+        STROW(14, cH0,cH1,cH2,cH3,cH4,cH5,cH6,cH7, s6);
+        STROW(15, cH0,cH1,cH2,cH3,cH4,cH5,cH6,cH7, s7);
+#undef STROW
+    }
+}
